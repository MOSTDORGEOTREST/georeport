# PostgreSQL (внешняя БД)
POSTGRES_USER=georeport
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres.example.com
POSTGRES_PORT=5432
POSTGRES_NAME=georeport

# Backend
HOST_IP=127.0.0.1
PUBLIC_BASE_URL=https://georeport.ru
SEED_DEMO_DATA=false
FILE_COUNT=10
FILE_SIZE=1024
JWT_SECRET=generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
SUPERUSER_NAME=admin
SUPERUSER_PASSWORD=change-me

# AWS S3 / MinIO
AWS_URI=https://s3.example.com
AWS_ACCCESS_KEY=change-me
AWS_SERVICE_NAME=s3
AWS_SECRET_KEY=change-me
AWS_REGION=us-east-1
AWS_BUCKET=georeport

# Docker images (можно заменить адресами доверенного registry-зеркала)
PYTHON_IMAGE=python:3.10-slim-bookworm
NODE_IMAGE=node:22-alpine
NGINX_IMAGE=nginx:1.27-alpine
POSTGRES_IMAGE=postgres:15-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
